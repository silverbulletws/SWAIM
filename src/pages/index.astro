---
// src/pages/index.astro
import Base from "../layouts/Base.astro";
import Seal from "../components/Seal.astro";
import { site } from "../data/site.js";

const surveying = [
  { name: "Oil and Gas Surveys", blurb: "Well locations, pad sites, pipeline routes, and lease boundaries." },
  { name: "Land and Boundary Surveys", blurb: "Where your property actually ends — documented and defensible." },
  { name: "Mapping", blurb: "Topographic and planimetric mapping built for the work that follows." },
  { name: "Platting", blurb: "Subdivision plats prepared to city and county standards." },
  { name: "Right-of-Way Determination", blurb: "Easements and ROW research for roads, utilities, and pipelines." },
  { name: "Construction Staking", blurb: "Grade, offset, and layout staking so crews build to the plan." },
  { name: "GPS Surveying", blurb: "RTK and static control for large tracts and remote sites." },
];

const engineering = [
  { name: "Site Development", blurb: "Grading, layout, and utilities from raw dirt to a buildable pad." },
  { name: "Roadway Design", blurb: "County roads, subdivision streets, and access drives." },
  { name: "Water and Sewer Design", blurb: "Distribution, collection, and lift stations sized to the demand." },
  { name: "Drainage Design", blurb: "Detention, culverts, and drainage studies that hold up to review." },
  { name: "Feasibility Studies", blurb: "Find out what a site will cost you before you own the problem." },
  { name: "Park and Trail Design", blurb: "Public space design for cities and civic projects." },
  { name: "Construction Management", blurb: "Someone watching the build who read the plans first." },
  { name: "Special Services and Scanning", blurb: "Document scanning, exhibits, and one-off technical work." },
];

// Project cards. status: "page" | "pdf" | "soon"
const projects = [
  { kind: "Site plan", name: "Kingdom Ridge", status: "page", href: "/projects/kingdom-ridge" },
  { kind: "Site plan", name: "Crown Point", status: "pdf", href: "/assets/site-plan-crown-point.pdf" },
  { kind: "Site plan", name: "United Storage", status: "soon" },
  { kind: "Sketch", name: "Access Road", status: "soon" },
  { kind: "Site plan", name: "Project 5", status: "soon" },
  { kind: "Site plan", name: "Project 6", status: "soon" },
  { kind: "Site plan", name: "Project 7", status: "soon" },
  { kind: "Site plan", name: "Project 8", status: "soon" },
  { kind: "Site plan", name: "Project 9", status: "soon" },
  { kind: "Site plan", name: "Project 10", status: "soon" },
  { kind: "Site plan", name: "Project 11", status: "soon" },
  { kind: "Site plan", name: "Project 12", status: "soon" },
];

const creds = [
  {
    id: "def-rpls",
    abbr: "RPLS",
    title: "Registered Professional Land Surveyor",
    body: "A state-licensed surveyor authorized to determine land boundaries, write legal property descriptions, and prepare the surveys used in land transactions. Licensure requires education, documented field experience, state board examinations, and ongoing continuing education.",
    services: surveying,
    heading: "Surveying",
  },
  {
    id: "def-pe",
    abbr: "P.E.",
    title: "Professional Engineer",
    body: "A state-licensed engineer authorized to design, seal, and take responsibility for engineering work under established technical and safety standards. Licensure requires an accredited degree, documented experience, state board examinations, and ongoing continuing education.",
    services: engineering,
    heading: "Engineering",
  },
];
---

<Base
  title="Swaim Engineering and Surveying — Bowie, Texas"
  description="Licensed civil engineering and land surveying under one roof in Bowie, Texas. Boundary surveys, platting, site development, drainage, and construction staking since 2003."
  theme="dark"
  header="overlay"
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <video
      class="hero-video"
      src="/assets/downtown-bowie.mp4"
      poster="/assets/downtown-bowie-poster.webp"
      autoplay muted loop playsinline aria-hidden="true"
    ></video>
    <div class="hero-scrim"></div>

    <div class="hero-inner">
      <p class="eyebrow">Bowie, Texas &nbsp;·&nbsp; 33.5590&deg; N, 97.8486&deg; W</p>
      <h1>
        The engineer and the surveyor<br />
        <em>work down the hall from each other.</em>
      </h1>
      <p class="hero-sub">
        Most projects need both. Most towns make you hire twice. We've kept a licensed
        Professional Engineer and a Registered Professional Land Surveyor under the same roof
        in Montague County since {site.founded}.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href={site.phoneHref}>Call {site.phone}</a>
        <a class="btn-ghost" href="#services">See what we do</a>
      </div>
    </div>

    <div class="seals">
      <Seal which="pe" />
      <Seal which="rpls" />
    </div>
  </section>

  <!-- ============ THESIS ============ -->
  <section class="thesis">
    <div class="thesis-copy">
      <p class="label">Why that matters</p>
      <p class="lede">
        When your surveyor and your engineer are two different firms, you are the one carrying
        drawings between them. Boundary comes back late. The grading plan gets drawn off the
        wrong line. Somebody has to eat the change order.
      </p>
      <p>
        Here, the boundary work and the design work happen in the same building, off the same
        field data, checked by people who talk to each other before there's a problem. That's
        not a sales pitch. It's just how the office is laid out.
      </p>
    </div>
    <figure class="thesis-figure">
      <img src="/assets/reviewing-a-design-with-red-pens.webp" alt="Reviewing a design set with red pens" />
      <figcaption>Markup on a site plan set, Bowie office</figcaption>
    </figure>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="services" id="services">
    <div class="services-head">
      <h2>Two disciplines, one office</h2>
      <p>Fifteen services. Call about any of them, or call and describe the problem — that works too.</p>
    </div>

    <div class="services-grid">
      {creds.map((d) => (
        <div class="discipline">
          <div class="discipline-head">
            <span class="rule"></span>
            <h3>{d.heading}</h3>
            <button class="cred" type="button" aria-expanded="false" aria-controls={d.id}>{d.abbr}</button>
            <div class="cred-pop" id={d.id} hidden>
              <p><strong>{d.title}</strong></p>
              <p>{d.body}</p>
            </div>
          </div>
          <ul>
            {d.services.map((s) => (
              <li>
                <span class="svc-name">{s.name}</span>
                <span class="svc-blurb">{s.blurb}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section class="work">
    <div class="work-head">
      <p class="label">Recent sets</p>
      <h2>Plans that got built</h2>
    </div>
    <div class="work-grid">
      {projects.map((p) =>
        p.status === "soon" ? (
          <span class="work-card is-soon">
            <span class="work-kind">{p.kind}</span>
            <span class="work-name">{p.name}</span>
            <span class="work-open">Coming soon</span>
          </span>
        ) : (
          <a
            class="work-card"
            href={p.href}
            target={p.status === "pdf" ? "_blank" : undefined}
            rel={p.status === "pdf" ? "noopener" : undefined}
          >
            <span class="work-kind">{p.kind}</span>
            <span class="work-name">{p.name}</span>
            <span class="work-open">
              {p.status === "pdf" ? "Open PDF →" : "Go to project page →"}
            </span>
          </a>
        )
      )}
    </div>
  </section>

  <!-- ============ ROOTS ============ -->
  <section class="roots">
    <img class="roots-bg" src="/assets/pic-of-old-mountague-county-soil-survey-on-desk.webp" alt="" aria-hidden="true" />
    <div class="roots-scrim"></div>
    <div class="roots-inner">
      <p class="label light">Montague County</p>
      <h2>We've got the old soil survey on the desk, not in a box.</h2>
      <p>
        Over two decades of plats, field notes, and county records for this part of Texas — and the
        institutional memory of who moved which fence and when. If your tract has a history,
        there's a fair chance it's already in our files.
      </p>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="contact" id="contact">
    <div class="contact-copy">
      <h2>Tell us about the project</h2>
      <p>Give it a name and we'll pick it up from there. Takes about a minute.</p>

      <div class="starter">
        <label class="contact-label" for="project-name">Start here</label>
        <div class="starter-row">
          <input id="project-name" type="text" placeholder="Your Project Name" autocomplete="off" />
          <button class="btn-primary" type="button" id="project-go">Continue</button>
        </div>
        <p class="starter-hint">Boundary survey, site plan, drainage study — whatever you're calling it.</p>
      </div>

      <div class="or-call">
        <span class="or-rule"></span>
        <span class="mono">or just call</span>
        <span class="or-rule"></span>
      </div>

      <a class="big-phone" href={site.phoneHref}>{site.phone}</a>

      <div class="contact-ready">
        <p class="contact-label">Handy to have</p>
        <ul class="contact-list">
          <li>County and approximate acreage</li>
          <li>A deed or existing plat, if you've got one</li>
          <li>What the land is going to become</li>
          <li>Any deadline you're working against</li>
        </ul>
        <p class="contact-note">Don't have all that? Call anyway. We'll figure out what's missing.</p>
      </div>
    </div>

    <figure class="contact-figure">
      <img src="/assets/jason-reviewing-design-diagrams.webp" alt="Jason Swaim reviewing design diagrams" />
      <figcaption>
        <span class="quote">&ldquo;Details matter.&rdquo;</span>
        <span class="attrib">- Jason G. Swaim, P.E., R.P.L.S.</span>
      </figcaption>
    </figure>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(10rem, 17vh, 13rem) var(--pad) clamp(9rem, 18vh, 14rem);
    overflow: hidden;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(14, 31, 42, 0.93) 0%, rgba(14, 31, 42, 0.78) 45%, rgba(14, 31, 42, 0.45) 100%),
      linear-gradient(to top, var(--ink) 3%, rgba(14, 31, 42, 0.2) 40%);
  }
  .hero-inner { position: relative; max-width: 46rem; }

  .hero h1 {
    font-size: clamp(2.4rem, 6.2vw, 4.6rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .hero h1 em { font-style: normal; color: var(--blue); }

  .hero-sub {
    max-width: 40rem;
    margin: 1.75rem 0 0;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.3vw, 1.65rem);
    line-height: 1.35;
    opacity: 0.88;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.25rem; }
  .hero .btn-primary,
  .hero .btn-ghost { padding: 0.95rem 1.6rem; }

  .seals {
    position: absolute;
    right: var(--pad);
    bottom: clamp(4rem, 9vh, 7rem);
    display: flex;
    flex-direction: row-reverse;
    gap: 1rem;
    z-index: 4;
  }
  @media (max-width: 860px) { .seals { display: none; } }

  /* ---------- thesis ---------- */
  .thesis {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(5rem, 12vw, 8.5rem) var(--pad);
  }
  .thesis .lede {
    font-size: clamp(1.25rem, 2.3vw, 1.65rem);
    line-height: 1.35;
    font-family: var(--display);
    font-weight: 600;
    margin: 0 0 1.5rem;
  }
  .thesis p:last-child { margin: 0; opacity: 0.8; max-width: 34rem; }
  .thesis-figure { margin: 0; }
  .thesis-figure img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--hair);
  }
  .thesis-figure figcaption {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-top: 0.75rem;
  }
  @media (max-width: 860px) { .thesis { grid-template-columns: 1fr; } }

  /* ---------- services ---------- */
  .services {
    background: var(--buff);
    color: var(--ink);
    padding: clamp(4.5rem, 10vw, 8rem) var(--pad);
  }
  .services-head { max-width: 42rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .services-head h2 { font-size: clamp(2rem, 4.4vw, 3.2rem); text-transform: uppercase; }
  .services-head p { margin: 1rem 0 0; opacity: 0.72; }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (max-width: 860px) { .services-grid { grid-template-columns: 1fr; } }

  .discipline-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
  }
  .discipline-head h3 { font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .discipline-head .rule { width: 26px; height: 2px; background: var(--flag); flex: none; }

  .cred {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--hair-ink-2);
    padding: 0.3rem 0.6rem;
    cursor: help;
    transition: border-color 0.2s, color 0.2s;
  }
  .cred:hover,
  .cred[aria-expanded="true"] { border-color: var(--flag); color: var(--flag); }

  .cred-pop {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 20;
    width: min(24rem, 82vw);
    background: var(--ink);
    color: var(--buff);
    padding: 1.25rem 1.4rem;
    box-shadow: 0 14px 40px rgba(14, 31, 42, 0.35);
  }
  .cred-pop[hidden] { display: none; }
  .cred-pop p { margin: 0 0 0.7rem; font-size: 0.9rem; line-height: 1.55; opacity: 0.85; }
  .cred-pop p:last-child { margin-bottom: 0; }
  .cred-pop strong {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--blue);
    opacity: 1;
  }

  .discipline ul { list-style: none; margin: 0; padding: 0; }
  .discipline li {
    display: grid;
    gap: 0.3rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--hair-ink);
  }
  .svc-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.08rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .svc-blurb { font-size: 0.94rem; opacity: 0.7; line-height: 1.5; }

  /* ---------- work ---------- */
  .work { padding: clamp(4.5rem, 10vw, 8rem) var(--pad); }
  .work-head { margin-bottom: 2.5rem; }
  .work-head h2 { font-size: clamp(1.8rem, 3.8vw, 2.6rem); text-transform: uppercase; }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
  }
  .work-card {
    background: var(--ink);
    padding: 1.75rem 1.5rem 1.5rem;
    text-decoration: none;
    display: grid;
    gap: 0.4rem;
    min-height: 11rem;
    align-content: start;
    transition: background 0.2s;
  }
  .work-card:hover { background: var(--ink-2); }
  .work-kind {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .work-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.35rem;
    text-transform: uppercase;
  }
  .work-open {
    margin-top: auto;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .work-card:hover .work-open { opacity: 1; color: var(--flag); }

  .is-soon { cursor: default; opacity: 0.55; }
  .is-soon:hover { background: var(--ink); }
  .is-soon:hover .work-open { opacity: 0.55; color: inherit; }

  @media (max-width: 1100px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .work-grid { grid-template-columns: 1fr; } }

  /* ---------- roots ---------- */
  .roots { position: relative; padding: clamp(5rem, 14vw, 10rem) var(--pad); overflow: hidden; }
  .roots-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .roots-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(14, 31, 42, 0.94) 30%, rgba(14, 31, 42, 0.6) 100%);
  }
  .roots-inner { position: relative; max-width: 40rem; }
  .roots-inner h2 {
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .roots-inner p:last-child { margin: 0; opacity: 0.85; }

  /* ---------- contact ---------- */
  .contact {
    background: var(--buff-2);
    color: var(--ink);
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(4.5rem, 10vw, 8rem) var(--pad);
  }
  .contact h2 { font-size: clamp(2rem, 4.4vw, 3rem); text-transform: uppercase; }
  .contact-copy > p { max-width: 30rem; opacity: 0.75; }

  .starter { margin: 2rem 0 0; max-width: 30rem; }
  .starter-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .starter input {
    flex: 1 1 14rem;
    font-family: var(--body);
    font-size: 1rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid rgba(14, 31, 42, 0.25);
    padding: 0.95rem 1rem;
  }
  .starter input::placeholder { opacity: 0.4; }
  .starter input:focus { outline: 2px solid var(--flag); outline-offset: 0; }
  .starter .btn-primary { padding: 0.95rem 1.6rem; }
  .starter-hint { margin: 0.75rem 0 0; font-size: 0.86rem; opacity: 0.55; }

  .or-call {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 30rem;
    margin: 2.25rem 0 0.5rem;
    opacity: 0.45;
  }
  .or-rule { flex: 1; height: 1px; background: rgba(14, 31, 42, 0.3); }

  .big-phone {
    display: inline-block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    text-decoration: none;
    color: var(--flag);
    letter-spacing: -0.02em;
    margin: 1rem 0 2rem;
  }
  .big-phone:hover { text-decoration: underline; text-underline-offset: 6px; }

  .contact-ready { max-width: 28rem; }
  .contact-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0 0 0.7rem;
  }
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: 0.95rem;
    opacity: 0.78;
  }
  .contact-list li { padding-left: 1.1rem; position: relative; }
  .contact-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--flag);
  }
  .contact-note { margin: 1.25rem 0 0; font-size: 0.9rem; opacity: 0.6; }

  .contact-figure { margin: 0; }
  .contact-figure img { width: 100%; height: auto; display: block; }
  .contact-figure figcaption { margin-top: 1rem; display: grid; gap: 0.4rem; }
  .contact-figure .quote {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--ink);
  }
  .contact-figure .attrib {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>

<style is:global>
  /* Hero + footer seals are sized by context. */
  .seals .seal-btn img {
    width: clamp(76px, 9vw, 118px);
    filter: drop-shadow(0 8px 22px rgba(0, 0, 0, 0.5));
  }
</style>

<script>
  // Credential popovers.
  document.querySelectorAll("button.cred").forEach((btn) => {
    const pop = document.getElementById(btn.getAttribute("aria-controls"));
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = btn.getAttribute("aria-expanded") === "true";
      document.querySelectorAll("button.cred").forEach((b) => {
        b.setAttribute("aria-expanded", "false");
        document.getElementById(b.getAttribute("aria-controls")).hidden = true;
      });
      if (!open) {
        btn.setAttribute("aria-expanded", "true");
        pop.hidden = false;
      }
    });
  });

  document.addEventListener("click", () => {
    document.querySelectorAll("button.cred").forEach((b) => {
      b.setAttribute("aria-expanded", "false");
      document.getElementById(b.getAttribute("aria-controls")).hidden = true;
    });
  });

  // Project-name handoff to /start.
  const projectGo = document.getElementById("project-go");
  if (projectGo) {
    const field = document.getElementById("project-name");
    const send = () => {
      const name = field.value.trim();
      window.location.href = "/start" + (name ? "?project=" + encodeURIComponent(name) : "");
    };
    projectGo.addEventListener("click", send);
    field.addEventListener("keydown", (e) => { if (e.key === "Enter") send(); });
  }
</script>
