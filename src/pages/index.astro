---
// src/pages/index.astro
// Swaim Engineering and Surveying — homepage
// Styles are scoped CSS custom properties so this drops in regardless of
// whether you're on Tailwind v3 or v4. No config changes required.

const phone = "940-872-5075";
const phoneHref = "tel:+19408725075";
const email = "info@swaimengineering.com";
const emailHref = "mailto:info@swaimengineering.com";
const mapHref = "https://www.google.com/maps/search/?api=1&query=506+N+Mason+St,+Bowie,+TX+76230";
const facebookHref = "https://www.facebook.com/";
const linkedinHref = "https://www.linkedin.com/company/swaim-engineering-&-surveying/";

const surveying = [
  { name: "Oil and Gas Surveys", blurb: "Well locations, pad sites, pipeline routes, and lease boundaries." },
  { name: "Land and Boundary Surveys", blurb: "Where your property actually ends — documented and defensible." },
  { name: "Mapping", blurb: "Topographic and planimetric mapping built for the work that follows." },
  { name: "Platting", blurb: "Subdivision plats prepared to city and county standards." },
  { name: "Right-of-Way Determination", blurb: "Easements and ROW research for roads, utilities, and pipelines." },
  { name: "Construction Staking", blurb: "Grade, offset, and layout staking so crews build to the plan." },
  { name: "GPS Surveying", blurb: "RTK and static control for large tracts and remote sites." },
];

const engineering = [
  { name: "Site Development", blurb: "Grading, layout, and utilities from raw dirt to a buildable pad." },
  { name: "Roadway Design", blurb: "County roads, subdivision streets, and access drives." },
  { name: "Water and Sewer Design", blurb: "Distribution, collection, and lift stations sized to the demand." },
  { name: "Drainage Design", blurb: "Detention, culverts, and drainage studies that hold up to review." },
  { name: "Feasibility Studies", blurb: "Find out what a site will cost you before you own the problem." },
  { name: "Park and Trail Design", blurb: "Public space design for cities and civic projects." },
  { name: "Construction Management", blurb: "Someone watching the build who read the plans first." },
  { name: "Special Services and Scanning", blurb: "Document scanning, exhibits, and one-off technical work." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Swaim Engineering and Surveying — Bowie, Texas</title>
    <meta
      name="description"
      content="Licensed civil engineering and land surveying under one roof in Bowie, Texas. Boundary surveys, platting, site development, drainage, and construction staking since 2003."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Archivo+Narrow:wght@600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- ============ HEADER ============ -->
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/assets/swaim-logo-inverted.webp" alt="Swaim Engineering and Surveying" />
      </a>
      <nav class="nav">
        <a href="/about">Company</a>
        <a href="/surveying">Surveying</a>
        <a href="/engineering">Engineering</a>
        <a class="nav-phone" href={phoneHref}>{phone}</a>
        <a class="nav-social" href={facebookHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H16.7V4.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.03 1.46-4.03 4.15v2.32H7.5V14h2.75v8z"/></svg>
        </a>
      </nav>
    </header>

    <!-- ============ HERO ============ -->
    <section class="hero">
      <video
        class="hero-video"
        src="/assets/downtown-bowie.mp4"
        poster="/assets/downtown-bowie-poster.webp"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
      ></video>
      <div class="hero-scrim"></div>

      <div class="hero-inner">
        <p class="eyebrow">Bowie, Texas &nbsp;·&nbsp; 33.5590&deg; N, 97.8486&deg; W</p>
        <h1>
          The engineer and the surveyor<br />
          <em>work down the hall from each other.</em>
        </h1>
        <p class="hero-sub">
          Most projects need both. Most towns make you hire twice. We've kept a licensed
          Professional Engineer and a Registered Professional Land Surveyor under the same roof
          in Montague County since 2003.
        </p>
        <div class="hero-actions">
          <a class="btn-primary" href={phoneHref}>Call {phone}</a>
          <a class="btn-ghost" href="#services">See what we do</a>
        </div>
      </div>

      <!-- Signature: the two seals straddle the fold -->
      <div class="seals">
        <button class="seal-btn" type="button"
          data-seal="/assets/swaim-texas-professional-engineer-seal.webp"
          data-caption="Texas Professional Engineer">
          <img src="/assets/swaim-texas-professional-engineer-seal.webp" alt="Texas Professional Engineer seal" />
        </button>
        <button class="seal-btn" type="button"
          data-seal="/assets/swaim-texas-land-surveyor-seal.webp"
          data-caption="Texas Registered Professional Land Surveyor">
          <img src="/assets/swaim-texas-land-surveyor-seal.webp" alt="Texas Registered Professional Land Surveyor seal" />
        </button>
      </div>
    </section>

    <!-- ============ THESIS BAND ============ -->
    <section class="thesis">
      <div class="thesis-copy">
        <p class="label">Why that matters</p>
        <p class="lede">
          When your surveyor and your engineer are two different firms, you are the one carrying
          drawings between them. Boundary comes back late. The grading plan gets drawn off the
          wrong line. Somebody has to eat the change order.
        </p>
        <p>
          Here, the boundary work and the design work happen in the same building, off the same
          field data, checked by people who talk to each other before there's a problem. That's
          not a sales pitch. It's just how the office is laid out.
        </p>
      </div>
      <figure class="thesis-figure">
        <img src="/assets/reviewing-a-design-with-red-pens.webp" alt="Reviewing a design set with red pens" />
        <figcaption>Markup on a site plan set, Bowie office</figcaption>
      </figure>
    </section>

    <!-- ============ SERVICES ============ -->
    <section class="services" id="services">
      <div class="services-head">
        <h2>Two disciplines, one office</h2>
        <p>Fifteen services. Call about any of them, or call and describe the problem — that works too.</p>
      </div>

      <div class="services-grid">
        <div class="discipline">
          <div class="discipline-head">
            <span class="rule"></span>
            <h3>Surveying</h3>
            <button class="cred" type="button" aria-expanded="false" aria-controls="def-rpls">RPLS</button>
            <div class="cred-pop" id="def-rpls" hidden>
              <p><strong>Registered Professional Land Surveyor</strong></p>
              <p>A state-licensed surveyor authorized to determine land boundaries, write legal property descriptions, and prepare the surveys used in land transactions. Licensure requires education, documented field experience, state board examinations, and ongoing continuing education.</p>
            </div>
          </div>
          <ul>
            {surveying.map((s) => (
              <li>
                <span class="svc-name">{s.name}</span>
                <span class="svc-blurb">{s.blurb}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="discipline">
          <div class="discipline-head">
            <span class="rule"></span>
            <h3>Engineering</h3>
            <button class="cred" type="button" aria-expanded="false" aria-controls="def-pe">P.E.</button>
            <div class="cred-pop" id="def-pe" hidden>
              <p><strong>Professional Engineer</strong></p>
              <p>A state-licensed engineer authorized to design, seal, and take responsibility for engineering work under established technical and safety standards. Licensure requires an accredited degree, documented experience, state board examinations, and ongoing continuing education.</p>
            </div>
          </div>
          <ul>
            {engineering.map((s) => (
              <li>
                <span class="svc-name">{s.name}</span>
                <span class="svc-blurb">{s.blurb}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ WORK / PROOF ============ -->
    <section class="work">
      <div class="work-head">
        <p class="label">Recent sets</p>
        <h2>Plans that got built</h2>
      </div>
      <div class="work-grid">
        <a class="work-card" href="/projects/kingdom-ridge">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Kingdom Ridge</span>
          <span class="work-open">Go to project page &rarr;</span>
        </a>
        <a class="work-card" href="/assets/site-plan-crown-point.pdf" target="_blank" rel="noopener">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Crown Point</span>
          <span class="work-open">Open PDF &rarr;</span>
        </a>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">United Storage</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Sketch</span>
          <span class="work-name">Access Road</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 5</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 6</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 7</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 8</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 9</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 10</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 11</span>
          <span class="work-open">Coming soon</span>
        </span>
        <span class="work-card is-soon">
          <span class="work-kind">Site plan</span>
          <span class="work-name">Project 12</span>
          <span class="work-open">Coming soon</span>
        </span>
      </div>
    </section>

    <!-- ============ ROOTS BAND ============ -->
    <section class="roots">
      <img class="roots-bg" src="/assets/pic-of-old-mountague-county-soil-survey-on-desk.webp" alt="" aria-hidden="true" />
      <div class="roots-scrim"></div>
      <div class="roots-inner">
        <p class="label light">Montague County</p>
        <h2>We've got the old soil survey on the desk, not in a box.</h2>
        <p>
          Over two decades of plats, field notes, and county records for this part of Texas — and the
          institutional memory of who moved which fence and when. If your tract has a history,
          there's a fair chance it's already in our files.
        </p>
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section class="contact" id="contact">
      <div class="contact-copy">
        <h2>Tell us about the project</h2>
        <p>
          Give it a name and we'll pick it up from there. Takes about a minute.
        </p>

        <div class="starter">
          <label class="contact-label" for="project-name">Start here</label>
          <div class="starter-row">
            <input
              id="project-name"
              type="text"
              placeholder="Your Project Name"
              autocomplete="off"
            />
            <button class="btn-primary" type="button" id="project-go">Continue</button>
          </div>
          <p class="starter-hint">Boundary survey, site plan, drainage study &mdash; whatever you're calling it.</p>
        </div>

        <div class="or-call">
          <span class="or-rule"></span>
          <span class="mono">or just call</span>
          <span class="or-rule"></span>
        </div>

        <a class="big-phone" href={phoneHref}>{phone}</a>

        <div class="contact-ready">
          <p class="contact-label">Handy to have</p>
          <ul class="contact-list">
            <li>County and approximate acreage</li>
            <li>A deed or existing plat, if you've got one</li>
            <li>What the land is going to become</li>
            <li>Any deadline you're working against</li>
          </ul>
          <p class="contact-note">Don't have all that? Call anyway. We'll figure out what's missing.</p>
        </div>
      </div>
      <figure class="contact-figure">
        <img src="/assets/jason-reviewing-design-diagrams.webp" alt="Jason Swaim reviewing design diagrams" />
        <figcaption>
          <span class="quote">&ldquo;Details matter.&rdquo;</span>
          <span class="attrib">- Jason G. Swaim, P.E., R.P.L.S.</span>
        </figcaption>
      </figure>
    </section>

    <!-- ============ FOOTER AS TITLE BLOCK ============ -->
    <footer class="title-block">
      <div class="tb-cell tb-firm">
        <img src="/assets/swaim-logo-inverted.webp" alt="Swaim Engineering and Surveying" />
        <address class="tb-address">
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            <a href={mapHref} target="_blank" rel="noopener noreferrer">506 North Mason<br />Bowie, TX 76230</a>
          </span>
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5C11.6 19 5 12.4 5 5.1A1.5 1.5 0 0 1 6.5 3.5z"/></svg>
            <a href={phoneHref}>{phone}</a>
          </span>
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
            <a href={emailHref}>{email}</a>
          </span>
          <span class="tb-social">
            <a href={facebookHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H16.7V4.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.03 1.46-4.03 4.15v2.32H7.5V14h2.75v8z"/></svg>
            </a>
            <a href={linkedinHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0zM3.3 8.4h3.4V20H3.3zM9.5 8.4h3.25v1.6h.05c.45-.85 1.56-1.75 3.2-1.75 3.42 0 4.05 2.25 4.05 5.18V20h-3.4v-5.9c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.53-2.25 3.1V20H9.5z"/></svg>
            </a>
          </span>
        </address>
      </div>
      <div class="tb-cell">
        <p class="tb-label">Surveying</p>
        <a href="/surveying">Boundary</a>
        <a href="/surveying">Platting</a>
        <a href="/surveying">Staking</a>
        <a href="/surveying">Oil &amp; gas</a>
      </div>
      <div class="tb-cell">
        <p class="tb-label">Engineering</p>
        <a href="/engineering">Site development</a>
        <a href="/engineering">Roadway</a>
        <a href="/engineering">Drainage</a>
        <a href="/engineering">Water &amp; sewer</a>
      </div>
      <div class="tb-cell tb-stamp">
        <p class="tb-label">Licensed</p>
        <div class="tb-seals">
          <button class="seal-btn" type="button"
            data-seal="/assets/swaim-texas-professional-engineer-seal.webp"
            data-caption="Texas Professional Engineer">
            <img src="/assets/swaim-texas-professional-engineer-seal.webp" alt="Texas P.E. seal" />
          </button>
          <button class="seal-btn" type="button"
            data-seal="/assets/swaim-texas-land-surveyor-seal.webp"
            data-caption="Texas Registered Professional Land Surveyor">
            <img src="/assets/swaim-texas-land-surveyor-seal.webp" alt="Texas RPLS seal" />
          </button>
        </div>
      </div>
      <div class="tb-bar mono">
        <span>&copy; {new Date().getFullYear()} Swaim Engineering and Surveying</span>
      </div>
    </footer>

    <style is:global>
      /* ---------- tokens ---------- */
      :root {
        --ink: #0e1f2a;          /* drafting ink — dominant surface */
        --ink-2: #16303f;        /* raised ink */
        --buff: #e7dfd0;         /* quad-map paper */
        --buff-2: #f3eee4;       /* lighter paper */
        --blue: #4a8ba8;         /* blueprint line */
        --flag: #e2571e;         /* surveyor's flagging tape — used sparingly */
        --hair: rgba(231, 223, 208, 0.22);

        --display: "Archivo Narrow", "Archivo", system-ui, sans-serif;
        --body: "Archivo", system-ui, -apple-system, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, monospace;

        --pad: clamp(1.25rem, 9vw, 10rem);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .hero-video { display: none; }
      }

      body {
        margin: 0;
        background: var(--ink);
        color: var(--buff);
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 {
        font-family: var(--display);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.01em;
        margin: 0;
      }

      a { color: inherit; }

      :focus-visible {
        outline: 2px solid var(--flag);
        outline-offset: 3px;
      }

      .mono {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .label {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--blue);
        margin: 0 0 1rem;
      }
      .label.light { color: var(--buff); opacity: 0.75; }

      /* ---------- header ---------- */
      .site-header {
        position: absolute;
        inset: 0 0 auto 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.5rem var(--pad);
      }
      .brand img { height: 55px; width: auto; display: block; }

      .nav {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        font-family: var(--mono);
        font-size: 0.84rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .nav a { text-decoration: none; opacity: 0.8; transition: opacity 0.2s; }
      .nav a:hover { opacity: 1; }
      .nav-phone {
        border: 1px solid var(--hair);
        padding: 0.5rem 0.9rem;
        opacity: 1 !important;
      }
      .nav-phone:hover { border-color: var(--flag); color: var(--flag); }

      @media (max-width: 860px) {
        .nav a:not(.nav-phone) { display: none; }
      }

      /* ---------- hero ---------- */
      .hero {
        position: relative;
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        align-items: center;
        padding: clamp(10rem, 17vh, 13rem) var(--pad) clamp(9rem, 18vh, 14rem);
        overflow: hidden;
      }
      .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero-scrim {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(100deg, rgba(14, 31, 42, 0.93) 0%, rgba(14, 31, 42, 0.78) 45%, rgba(14, 31, 42, 0.45) 100%),
          linear-gradient(to top, var(--ink) 3%, rgba(14, 31, 42, 0.2) 40%);
      }
      .hero-inner { position: relative; max-width: 46rem; }

      .eyebrow {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--buff);
        opacity: 0.7;
        margin: 0 0 1.5rem;
      }

      .hero h1 {
        font-size: clamp(2.4rem, 6.2vw, 4.6rem);
        text-transform: uppercase;
        letter-spacing: -0.02em;
      }
      .hero h1 em {
        font-style: normal;
        color: var(--blue);
      }

      .hero-sub {
        max-width: 40rem;
        margin: 1.75rem 0 0;
        font-family: var(--display);
        font-weight: 600;
        font-size: clamp(1.25rem, 2.3vw, 1.65rem);
        line-height: 1.35;
        opacity: 0.88;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 2.25rem;
      }

      .btn-primary,
      .btn-ghost {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 0.95rem 1.6rem;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .btn-primary { background: var(--flag); color: #fff; }
      .btn-primary:hover { background: #c94815; }
      .btn-ghost { border: 1px solid var(--hair); }
      .btn-ghost:hover { border-color: var(--buff); }

      .seals {
        position: absolute;
        right: var(--pad);
        bottom: clamp(4rem, 9vh, 7rem);
        display: flex;
        flex-direction: row-reverse;
        gap: 1rem;
        z-index: 4;
      }
      .seals img {
        width: clamp(76px, 9vw, 118px);
        height: auto;
        filter: drop-shadow(0 8px 22px rgba(0, 0, 0, 0.5));
      }
      @media (max-width: 860px) { .seals { display: none; } }

      /* ---------- thesis ---------- */
      .thesis {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: clamp(2rem, 6vw, 5rem);
        align-items: center;
        padding: clamp(5rem, 12vw, 8.5rem) var(--pad);
      }
      .thesis .lede {
        font-size: clamp(1.25rem, 2.3vw, 1.65rem);
        line-height: 1.35;
        font-family: var(--display);
        font-weight: 600;
        margin: 0 0 1.5rem;
      }
      .thesis p:last-child { margin: 0; opacity: 0.8; max-width: 34rem; }

      .thesis-figure { margin: 0; }
      .thesis-figure img {
        width: 100%;
        height: auto;
        display: block;
        border: 1px solid var(--hair);
      }
      .thesis-figure figcaption {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.55;
        margin-top: 0.75rem;
      }
      @media (max-width: 860px) { .thesis { grid-template-columns: 1fr; } }

      /* ---------- services ---------- */
      .services {
        background: var(--buff);
        color: var(--ink);
        padding: clamp(4.5rem, 10vw, 8rem) var(--pad);
      }
      .services-head { max-width: 42rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
      .services-head h2 {
        font-size: clamp(2rem, 4.4vw, 3.2rem);
        text-transform: uppercase;
      }
      .services-head p { margin: 1rem 0 0; opacity: 0.72; }

      .services-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(2.5rem, 6vw, 5rem);
      }
      @media (max-width: 860px) { .services-grid { grid-template-columns: 1fr; } }

      .discipline-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-bottom: 1.25rem;
        border-bottom: 2px solid var(--ink);
      }
      .discipline-head h3 {
        font-size: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .discipline-head .rule {
        width: 26px;
        height: 2px;
        background: var(--flag);
        flex: none;
      }
      .discipline-head .cred {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        border: 1px solid rgba(14, 31, 42, 0.3);
        padding: 0.3rem 0.6rem;
      }

      .discipline ul { list-style: none; margin: 0; padding: 0; }
      .discipline li {
        display: grid;
        gap: 0.3rem;
        padding: 1.15rem 0;
        border-bottom: 1px solid rgba(14, 31, 42, 0.14);
      }
      .svc-name {
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.08rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .svc-blurb { font-size: 0.94rem; opacity: 0.7; line-height: 1.5; }

      /* ---------- work ---------- */
      .work { padding: clamp(4.5rem, 10vw, 8rem) var(--pad); }
      .work-head { margin-bottom: 2.5rem; }
      .work-head h2 { font-size: clamp(1.8rem, 3.8vw, 2.6rem); text-transform: uppercase; }

      .work-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--hair);
        border: 1px solid var(--hair);
      }
      .work-card {
        background: var(--ink);
        padding: 1.75rem 1.5rem 1.5rem;
        text-decoration: none;
        display: grid;
        gap: 0.4rem;
        min-height: 11rem;
        align-content: start;
        transition: background 0.2s;
      }
      .work-card:hover { background: var(--ink-2); }
      .work-kind {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--blue);
      }
      .work-name {
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.35rem;
        text-transform: uppercase;
      }
      .work-open {
        margin-top: auto;
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.55;
      }
      .work-card:hover .work-open { opacity: 1; color: var(--flag); }

      /* ---------- roots ---------- */
      .roots {
        position: relative;
        padding: clamp(5rem, 14vw, 10rem) var(--pad);
        overflow: hidden;
      }
      .roots-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
      }
      .roots-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, rgba(14, 31, 42, 0.94) 30%, rgba(14, 31, 42, 0.6) 100%);
      }
      .roots-inner { position: relative; max-width: 40rem; }
      .roots-inner h2 {
        font-size: clamp(1.9rem, 4.2vw, 3rem);
        text-transform: uppercase;
        margin-bottom: 1.5rem;
      }
      .roots-inner p:last-child { margin: 0; opacity: 0.85; }

      /* ---------- contact ---------- */
      .contact {
        background: var(--buff-2);
        color: var(--ink);
        display: grid;
        grid-template-columns: 1fr 0.8fr;
        gap: clamp(2rem, 6vw, 5rem);
        align-items: center;
        padding: clamp(4.5rem, 10vw, 8rem) var(--pad);
      }
      .contact h2 { font-size: clamp(2rem, 4.4vw, 3rem); text-transform: uppercase; }
      .contact-copy > p { max-width: 30rem; opacity: 0.75; }

      .big-phone {
        display: inline-block;
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(2.2rem, 5.5vw, 3.6rem);
        text-decoration: none;
        color: var(--flag);
        letter-spacing: -0.02em;
        margin: 1rem 0 2rem;
      }
      .big-phone:hover { text-decoration: underline; text-underline-offset: 6px; }

      .contact-ready {
        max-width: 28rem;
      }
      .contact-label {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--blue);
        margin: 0 0 0.7rem;
      }
      .contact-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.55rem;
        font-size: 0.95rem;
        opacity: 0.78;
      }
      .contact-list li { padding-left: 1.1rem; position: relative; }
      .contact-list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.62em;
        width: 6px;
        height: 1px;
        background: var(--flag);
      }
      .contact-note {
        margin: 1.25rem 0 0;
        font-size: 0.9rem;
        opacity: 0.6;
      }

      .contact-figure { margin: 0; }
      .contact-figure img { width: 100%; height: auto; display: block; }
      .contact-figure figcaption {
        margin-top: 1rem;
        display: grid;
        gap: 0.4rem;
      }
      .contact-figure .quote {
        font-family: "Source Serif 4", Georgia, serif;
        font-weight: 400;
        font-style: italic;
        font-size: 1.5rem;
        line-height: 1.3;
        color: var(--ink);
      }
      .contact-figure .attrib {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.55;
      }
      @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }

      /* ---------- footer / title block ---------- */
      .title-block {
        background: var(--ink);
        border-top: 2px solid var(--buff);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 0 calc(var(--pad) - 1.5rem);
      }
      .tb-cell {
        padding: 2rem 1.5rem;
        border-right: 1px solid var(--hair);
        display: grid;
        gap: 0.55rem;
        align-content: start;
      }
      .tb-stamp { border-right: none; }
      .tb-cell a {
        text-decoration: none;
        font-size: 0.92rem;
        opacity: 0.72;
        transition: opacity 0.2s, color 0.2s;
      }
      .tb-cell a:hover { opacity: 1; color: var(--flag); }
      .tb-label {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--blue);
        margin: 0 0 0.4rem;
      }
      .tb-firm img { height: 40px; width: auto; }
      .tb-address {
        font-style: normal;
        font-size: 0.92rem;
        line-height: 1.4;
        opacity: 0.72;
        margin: 0;
        display: grid;
        gap: 0.7rem;
      }
      .tb-address a { opacity: 1; }
      .nav-social {
        display: inline-flex;
        align-items: center;
        opacity: 0.8;
        transition: opacity 0.2s, color 0.2s;
      }
      .nav-social svg { width: 20px; height: 20px; fill: currentColor; }
      .nav-social:hover { opacity: 1; color: var(--flag); }

      .tb-social {
        display: flex;
        gap: 0.85rem;
        padding-left: calc(16px + 0.65rem);
      }
      .tb-social a { display: inline-flex; opacity: 0.72; transition: opacity 0.2s, color 0.2s; }
      .tb-social svg { width: 20px; height: 20px; fill: currentColor; }
      .tb-social a:hover { opacity: 1; color: var(--flag); }
      .tb-line {
        display: grid;
        grid-template-columns: 16px 1fr;
        gap: 0.65rem;
        align-items: start;
      }
      .tb-line a:hover { color: var(--flag); }
      .tb-line svg {
        width: 16px;
        height: 16px;
        margin-top: 0.22em;
        fill: none;
        stroke: var(--blue);
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .tb-seals { display: flex; flex-direction: row-reverse; gap: 0.6rem; }
      .tb-seals img { width: 135px; height: auto; }
      .tb-bar {
        grid-column: 1 / -1;
        border-top: 1px solid var(--hair);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        opacity: 0.55;
      }
      @media (max-width: 980px) {
        .title-block { grid-template-columns: 1fr 1fr; }
        .tb-cell { border-bottom: 1px solid var(--hair); }
      }
      @media (max-width: 560px) {
        .title-block { grid-template-columns: 1fr; }
        .tb-cell { border-right: none; }
      }
      /* ---------- lightbox ---------- */
      .seal-btn {
        background: none;
        border: 0;
        padding: 0;
        cursor: zoom-in;
        display: block;
        transition: transform 0.2s;
      }
      .seal-btn:hover { transform: scale(1.05); }
      .seal-btn img {
        width: clamp(76px, 9vw, 118px);
        height: auto;
        display: block;
        filter: drop-shadow(0 8px 22px rgba(0, 0, 0, 0.5));
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(14, 31, 42, 0.94);
        display: grid;
        place-items: center;
        padding: var(--pad);
      }
      .lightbox[hidden] { display: none; }
      .lightbox figure { margin: 0; text-align: center; }
      .lightbox img {
        max-width: min(560px, 88vw);
        max-height: 76vh;
        width: auto;
        height: auto;
      }
      .lightbox figcaption {
        margin-top: 1.25rem;
        color: var(--buff);
        opacity: 0.7;
      }
      .lightbox-close {
        position: absolute;
        top: 1.5rem;
        right: var(--pad);
        background: none;
        border: 1px solid var(--hair);
        color: var(--buff);
        font-size: 1.75rem;
        line-height: 1;
        width: 3rem;
        height: 3rem;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s;
      }
      .lightbox-close:hover { border-color: var(--flag); color: var(--flag); }

      .label,
      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }
      .label::before,
      .eyebrow::before {
        content: "";
        width: 42px;
        height: 2px;
        background: currentColor;
        flex: none;
      }
      .discipline-head { position: relative; }
      button.cred {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        color: var(--ink);
        background: #fff;
        border: 1px solid rgba(14, 31, 42, 0.3);
        padding: 0.3rem 0.6rem;
        cursor: help;
        transition: border-color 0.2s, color 0.2s;
      }
      button.cred:hover,
      button.cred[aria-expanded="true"] { border-color: var(--flag); color: var(--flag); }

      .cred-pop {
        position: absolute;
        top: calc(100% + 0.6rem);
        right: 0;
        z-index: 20;
        width: min(24rem, 82vw);
        background: var(--ink);
        color: var(--buff);
        padding: 1.25rem 1.4rem;
        box-shadow: 0 14px 40px rgba(14, 31, 42, 0.35);
      }
      .cred-pop[hidden] { display: none; }
      .cred-pop p { margin: 0 0 0.7rem; font-size: 0.9rem; line-height: 1.55; opacity: 0.85; }
      .cred-pop p:last-child { margin-bottom: 0; }
      .cred-pop strong {
        font-family: var(--display);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: var(--blue);
        opacity: 1;
      }
      .starter { margin: 2rem 0 0; max-width: 30rem; }
      .starter-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
      .starter input {
        flex: 1 1 14rem;
        font-family: var(--body);
        font-size: 1rem;
        color: var(--ink);
        background: #fff;
        border: 1px solid rgba(14, 31, 42, 0.25);
        padding: 0.95rem 1rem;
      }
      .starter input::placeholder { opacity: 0.4; }
      .starter input:focus { outline: 2px solid var(--flag); outline-offset: 0; }
      .starter .btn-primary { border: 0; cursor: pointer; }
      .starter-hint { margin: 0.75rem 0 0; font-size: 0.86rem; opacity: 0.55; }

      .or-call {
        display: flex;
        align-items: center;
        gap: 1rem;
        max-width: 30rem;
        margin: 2.25rem 0 0.5rem;
        opacity: 0.45;
      }
      .or-rule { flex: 1; height: 1px; background: rgba(14, 31, 42, 0.3); }
    </style>
    <div class="lightbox" id="lightbox" hidden>
      <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
      <figure>
        <img id="lightbox-img" src="" alt="" />
        <figcaption id="lightbox-cap" class="mono"></figcaption>
      </figure>
    </div>
    <script>
      const box = document.getElementById("lightbox");
      const boxImg = document.getElementById("lightbox-img");
      const boxCap = document.getElementById("lightbox-cap");
      let lastFocus = null;

      function openBox(src, caption, trigger) {
        lastFocus = trigger;
        boxImg.src = src;
        boxImg.alt = caption;
        boxCap.textContent = caption;
        box.hidden = false;
        document.body.style.overflow = "hidden";
        box.querySelector(".lightbox-close").focus();
      }

      function closeBox() {
        box.hidden = true;
        boxImg.src = "";
        document.body.style.overflow = "";
        if (lastFocus) lastFocus.focus();
      }

      document.querySelectorAll(".seal-btn").forEach((btn) => {
        btn.addEventListener("click", () =>
          openBox(btn.dataset.seal, btn.dataset.caption, btn)
        );
      });

      box.querySelector(".lightbox-close").addEventListener("click", closeBox);
      box.addEventListener("click", (e) => {
        if (e.target === box) closeBox();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !box.hidden) closeBox();
      });

      document.querySelectorAll("button.cred").forEach((btn) => {
        const pop = document.getElementById(btn.getAttribute("aria-controls"));
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = btn.getAttribute("aria-expanded") === "true";
          document.querySelectorAll("button.cred").forEach((b) => {
            b.setAttribute("aria-expanded", "false");
            document.getElementById(b.getAttribute("aria-controls")).hidden = true;
          });
          if (!open) {
            btn.setAttribute("aria-expanded", "true");
            pop.hidden = false;
          }
        });
      });

      document.addEventListener("click", () => {
        document.querySelectorAll("button.cred").forEach((b) => {
          b.setAttribute("aria-expanded", "false");
          document.getElementById(b.getAttribute("aria-controls")).hidden = true;
        });
      });
      const projectGo = document.getElementById("project-go");
      if (projectGo) {
        const field = document.getElementById("project-name");
        const send = () => {
          const name = field.value.trim();
          window.location.href = "/start" + (name ? "?project=" + encodeURIComponent(name) : "");
        };
        projectGo.addEventListener("click", send);
        field.addEventListener("keydown", (e) => { if (e.key === "Enter") send(); });
      }
    </script>
  </body>
</html>
