---
// src/pages/projects/kingdom-ridge.astro
// PORTFOLIO TEMPLATE — everything below the `project` object is reusable.
// To add another project: copy this file, change the object, done.
//
// ⚠️  PLACEHOLDER CONTENT: every fact in this object is invented except the
//     PDF path. Get the real details from Jason before this goes public.

const project = {
  name: "Kingdom Ridge",
  discipline: "Engineering",           // or "Surveying" / "Engineering & Surveying"
  location: "Montague County, Texas",  // PLACEHOLDER
  client: "Kingdom Ridge Development", // PLACEHOLDER
  date: "2023–2024",                   // PLACEHOLDER
  scope: "Residential subdivision",    // PLACEHOLDER

  hero: "/assets/projects/kingdom-ridge-hero.webp",
  heroAlt: "Kingdom Ridge site plan",

  // Lead paragraph — sits under the title, sets the scene.
  summary:
    "A residential subdivision on rolling ground outside Bowie, taken from raw " +
    "acreage through boundary survey, platting, and full site design. Swaim handled " +
    "both the survey and the engineering, which meant the plat and the grading plan " +
    "were drawn off the same field data.",

  // The "what made this one interesting" story.
  storyTitle: "Water first, lots second",
  story:
    "The tract drained toward a single low point at the back of the property, which " +
    "meant detention had to be settled before anybody could say how many lots would " +
    "fit. We ran the drainage study up front and designed the pond into the layout " +
    "rather than around it. The county approved the plat on the first submittal.",

  services: [
    "Land and boundary survey",
    "Platting",
    "Drainage design",
    "Site development",
    "Construction staking",
  ],

  // Real file — already in your assets folder.
  planPdf: "/assets/site-plan-kingdom-ridge.pdf",
};

const phone = "940-872-5075";
const phoneHref = "tel:+19408725075";
const email = "info@swaimengineering.com";
const emailHref = "mailto:info@swaimengineering.com";
const mapHref = "https://www.google.com/maps/search/?api=1&query=506+N+Mason+St,+Bowie,+TX+76230";
const facebookHref = "https://www.facebook.com/";
const linkedinHref = "https://www.linkedin.com/company/swaim-engineering-&-surveying/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.name} — Swaim Engineering and Surveying</title>
    <meta name="description" content={project.summary.slice(0, 155)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Archivo+Narrow:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="proj-page">
    <header class="proj-header">
      <a class="brand" href="/">
        <img src="/assets/swaim-logo-inverted.webp" alt="Swaim Engineering and Surveying" />
      </a>
      <nav class="nav">
        <a href="/about">Company</a>
        <a href="/surveying">Surveying</a>
        <a href="/engineering">Engineering</a>
        <a class="nav-phone" href={phoneHref}>{phone}</a>
        <a class="nav-social" href={facebookHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H16.7V4.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.03 1.46-4.03 4.15v2.32H7.5V14h2.75v8z"/></svg>
        </a>
      </nav>
    </header>

    <!-- ============ TITLE ============ -->
    <section class="proj-title">
      <a class="crumb mono" href="/projects">&larr; All projects</a>
      <h1>{project.name}</h1>
      <p class="proj-meta mono">
        {project.discipline} <span class="dot">&middot;</span> {project.location}
      </p>
    </section>

    <!-- ============ HERO IMAGE ============ -->
    <figure class="proj-hero">
      <img src={project.hero} alt={project.heroAlt} />
    </figure>

    <!-- ============ FACTS + SUMMARY ============ -->
    <section class="proj-body">
      <aside class="proj-facts">
        <div class="fact">
          <p class="fact-label mono">Client</p>
          <p class="fact-value">{project.client}</p>
        </div>
        <div class="fact">
          <p class="fact-label mono">Project date</p>
          <p class="fact-value">{project.date}</p>
        </div>
        <div class="fact">
          <p class="fact-label mono">Location</p>
          <p class="fact-value">{project.location}</p>
        </div>
        <div class="fact">
          <p class="fact-label mono">Scope</p>
          <p class="fact-value">{project.scope}</p>
        </div>
        <a class="fact-pdf" href={project.planPdf} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5z"/><path d="M14 3v4.5h4.5"/></svg>
          <span>Open the plan set</span>
        </a>
      </aside>

      <div class="proj-summary">
        <p class="lede">{project.summary}</p>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="proj-story">
      <div class="proj-story-inner">
        <p class="label light">On this one</p>
        <h2>{project.storyTitle}</h2>
        <p>{project.story}</p>
      </div>
    </section>

    <!-- ============ SERVICES ============ -->
    <section class="proj-services">
      <p class="label">What we did</p>
      <ul class="svc-chips">
        {project.services.map((s) => <li>{s}</li>)}
      </ul>
      <div class="svc-links">
        <a class="text-link" href="/surveying">Surveying services &rarr;</a>
        <a class="text-link" href="/engineering">Engineering services &rarr;</a>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="proj-cta">
      <h2>Got something like this?</h2>
      <p>Give the project a name and we'll pick it up from there. Or just call the office.</p>
      <div class="proj-cta-actions">
        <a class="btn-primary" href="/start">Start a project</a>
        <a class="btn-ghost-light" href={phoneHref}>{phone}</a>
      </div>
    </section>

    <!-- ============ FOOTER AS TITLE BLOCK ============ -->
    <footer class="title-block">
      <div class="tb-cell tb-firm">
        <img src="/assets/swaim-logo-inverted.webp" alt="Swaim Engineering and Surveying" />
        <address class="tb-address">
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            <a href={mapHref} target="_blank" rel="noopener noreferrer">506 North Mason<br />Bowie, TX 76230</a>
          </span>
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5C11.6 19 5 12.4 5 5.1A1.5 1.5 0 0 1 6.5 3.5z"/></svg>
            <a href={phoneHref}>{phone}</a>
          </span>
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
            <a href={emailHref}>{email}</a>
          </span>
          <span class="tb-social">
            <a href={facebookHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H16.7V4.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.03 1.46-4.03 4.15v2.32H7.5V14h2.75v8z"/></svg>
            </a>
            <a href={linkedinHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0zM3.3 8.4h3.4V20H3.3zM9.5 8.4h3.25v1.6h.05c.45-.85 1.56-1.75 3.2-1.75 3.42 0 4.05 2.25 4.05 5.18V20h-3.4v-5.9c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.53-2.25 3.1V20H9.5z"/></svg>
            </a>
          </span>
        </address>
      </div>
      <div class="tb-cell">
        <p class="tb-label">Surveying</p>
        <a href="/surveying">Boundary</a>
        <a href="/surveying">Platting</a>
        <a href="/surveying">Staking</a>
        <a href="/surveying">Oil &amp; gas</a>
      </div>
      <div class="tb-cell">
        <p class="tb-label">Engineering</p>
        <a href="/engineering">Site development</a>
        <a href="/engineering">Roadway</a>
        <a href="/engineering">Drainage</a>
        <a href="/engineering">Water &amp; sewer</a>
      </div>
      <div class="tb-cell tb-stamp">
        <p class="tb-label">Licensed</p>
        <div class="tb-seals">
          <img src="/assets/swaim-texas-professional-engineer-seal.webp" alt="Texas P.E. seal" />
          <img src="/assets/swaim-texas-land-surveyor-seal.webp" alt="Texas RPLS seal" />
        </div>
      </div>
      <div class="tb-bar mono">
        <span>&copy; {new Date().getFullYear()} Swaim Engineering and Surveying</span>
      </div>
    </footer>

    <style is:global>
      /* ---------- tokens ---------- */
      :root {
        --ink: #0e1f2a;
        --ink-2: #16303f;
        --buff: #e7dfd0;
        --buff-2: #f3eee4;
        --blue: #4a8ba8;
        --flag: #e2571e;
        --hair: rgba(231, 223, 208, 0.22);

        --display: "Archivo Narrow", "Archivo", system-ui, sans-serif;
        --body: "Archivo", system-ui, -apple-system, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, monospace;
        --serif: "Source Serif 4", Georgia, serif;

        --pad: clamp(1.25rem, 9vw, 10rem);
      }

      * { box-sizing: border-box; }

      body.proj-page {
        margin: 0;
        background: var(--buff-2);
        color: var(--ink);
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2 {
        font-family: var(--display);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        margin: 0;
      }

      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--flag); outline-offset: 3px; }

      .mono {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .label {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--blue);
        margin: 0 0 1.25rem;
      }
      .label::before {
        content: "";
        width: 42px;
        height: 2px;
        background: currentColor;
        flex: none;
      }
      .label.light { color: var(--buff); opacity: 0.8; }

      /* ---------- header ---------- */
      .proj-header {
        background: var(--ink);
        color: var(--buff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.25rem var(--pad);
      }
      .brand img { height: 55px; width: auto; display: block; }
      .nav {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        font-family: var(--mono);
        font-size: 0.84rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .nav a { text-decoration: none; opacity: 0.8; transition: opacity 0.2s; }
      .nav a:hover { opacity: 1; }
      .nav-phone { border: 1px solid var(--hair); padding: 0.5rem 0.9rem; opacity: 1 !important; }
      .nav-phone:hover { border-color: var(--flag); color: var(--flag); }
      .nav-social { display: inline-flex; align-items: center; opacity: 0.8; transition: opacity 0.2s, color 0.2s; }
      .nav-social svg { width: 20px; height: 20px; fill: currentColor; }
      .nav-social:hover { opacity: 1; color: var(--flag); }
      @media (max-width: 860px) { .nav a:not(.nav-phone):not(.nav-social) { display: none; } }

      /* ---------- title ---------- */
      .proj-title { padding: clamp(2.5rem, 6vw, 4.5rem) var(--pad) clamp(2rem, 4vw, 3rem); }
      .crumb {
        display: inline-block;
        text-decoration: none;
        color: var(--blue);
        margin-bottom: 1.5rem;
        transition: color 0.2s;
      }
      .crumb:hover { color: var(--flag); }
      .proj-title h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); }
      .proj-meta {
        margin: 1.25rem 0 0;
        opacity: 0.6;
        font-size: 0.8rem;
      }
      .proj-meta .dot { margin: 0 0.5rem; color: var(--flag); }

      /* ---------- hero image ---------- */
      .proj-hero { margin: 0; padding: 0 var(--pad); }
      .proj-hero img {
        max-width: 100%;
        width: auto;
        height: auto;
        display: block;
        margin: 0 auto;
        border: 1px solid rgba(14, 31, 42, 0.16);
        background: var(--buff);
      }

      /* ---------- facts + summary ---------- */
      .proj-body {
        display: grid;
        grid-template-columns: 17rem 1fr;
        gap: clamp(2rem, 6vw, 5rem);
        padding: clamp(3rem, 7vw, 5rem) var(--pad);
        align-items: start;
      }
      .proj-facts { display: grid; gap: 1.5rem; align-content: start; }
      .fact { display: grid; gap: 0.25rem; }
      .fact-label { color: var(--blue); margin: 0; font-size: 0.66rem; letter-spacing: 0.14em; }
      .fact-value { margin: 0; font-size: 0.98rem; }

      .fact-pdf {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 0.5rem;
        padding: 0.9rem 1rem;
        border: 1px solid rgba(14, 31, 42, 0.28);
        text-decoration: none;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }
      .fact-pdf svg {
        width: 17px; height: 17px; flex: none;
        fill: none; stroke: currentColor; stroke-width: 1.6;
        stroke-linecap: round; stroke-linejoin: round;
      }
      .fact-pdf:hover { background: var(--ink); border-color: var(--ink); color: var(--buff); }

      .proj-summary .lede {
        margin: 0;
        font-family: var(--display);
        font-weight: 600;
        font-size: clamp(1.25rem, 2.4vw, 1.7rem);
        line-height: 1.35;
        max-width: 40rem;
      }
      @media (max-width: 860px) { .proj-body { grid-template-columns: 1fr; } }

      /* ---------- story ---------- */
      .proj-story {
        background: var(--ink);
        color: var(--buff);
        padding: clamp(4rem, 10vw, 7rem) var(--pad);
      }
      .proj-story-inner { max-width: 44rem; }
      .proj-story h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 1.5rem; }
      .proj-story p { margin: 0; opacity: 0.82; }

      /* ---------- services ---------- */
      .proj-services {
        background: var(--buff);
        padding: clamp(3.5rem, 8vw, 5.5rem) var(--pad);
      }
      .svc-chips {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }
      .svc-chips li {
        border: 1px solid rgba(14, 31, 42, 0.28);
        padding: 0.55rem 1rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }
      .svc-chips li:hover {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--buff);
      }
      .svc-links { display: flex; gap: 2rem; flex-wrap: wrap; margin-top: 2rem; }
      .text-link {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--flag);
      }
      .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }

      /* ---------- cta ---------- */
      .proj-cta {
        background: var(--ink);
        color: var(--buff);
        padding: clamp(4rem, 9vw, 6.5rem) var(--pad);
        text-align: center;
      }
      .proj-cta h2 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); }
      .proj-cta > p { margin: 1.25rem auto 2rem; opacity: 0.78; max-width: 30rem; }
      .proj-cta-actions { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

      .btn-primary,
      .btn-ghost-light {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 1.05rem 2rem;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }
      .btn-primary { background: var(--flag); color: #fff; border: 0; }
      .btn-primary:hover { background: #c94815; }
      .btn-ghost-light { border: 1px solid var(--hair); }
      .btn-ghost-light:hover { border-color: var(--flag); color: var(--flag); }

      /* ---------- footer / title block ---------- */
      .title-block {
        background: var(--ink);
        color: var(--buff);
        border-top: 2px solid var(--buff);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 0 calc(var(--pad) - 1.5rem);
      }
      .tb-cell {
        padding: 2rem 1.5rem;
        border-right: 1px solid var(--hair);
        display: grid;
        gap: 0.55rem;
        align-content: start;
      }
      .tb-stamp { border-right: none; }
      .tb-cell a {
        text-decoration: none;
        font-size: 0.92rem;
        opacity: 0.72;
        transition: opacity 0.2s, color 0.2s;
      }
      .tb-cell a:hover { opacity: 1; color: var(--flag); }
      .tb-label {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--blue);
        margin: 0 0 0.4rem;
      }
      .tb-firm img { height: 40px; width: auto; }
      .tb-address {
        font-style: normal;
        font-size: 0.92rem;
        line-height: 1.4;
        opacity: 0.72;
        margin: 0;
        display: grid;
        gap: 0.7rem;
      }
      .tb-address a { opacity: 1; }
      .tb-line { display: grid; grid-template-columns: 16px 1fr; gap: 0.65rem; align-items: start; }
      .tb-line a:hover { color: var(--flag); }
      .tb-line svg {
        width: 16px; height: 16px; margin-top: 0.22em;
        fill: none; stroke: var(--blue); stroke-width: 1.6;
        stroke-linecap: round; stroke-linejoin: round;
      }
      .tb-social { display: flex; gap: 0.85rem; padding-left: calc(16px + 0.65rem); }
      .tb-social a { display: inline-flex; opacity: 0.72; transition: opacity 0.2s, color 0.2s; }
      .tb-social svg { width: 20px; height: 20px; fill: currentColor; }
      .tb-social a:hover { opacity: 1; color: var(--flag); }
      .tb-seals { display: flex; flex-direction: row-reverse; gap: 0.6rem; }
      .tb-seals img { width: 104px; height: auto; }
      .tb-bar {
        grid-column: 1 / -1;
        border-top: 1px solid var(--hair);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        opacity: 0.55;
      }
      @media (max-width: 980px) {
        .title-block { grid-template-columns: 1fr 1fr; }
        .tb-cell { border-bottom: 1px solid var(--hair); }
      }
      @media (max-width: 560px) {
        .title-block { grid-template-columns: 1fr; }
        .tb-cell { border-right: none; }
      }
    </style>
  </body>
</html>
