---
// src/pages/surveying.astro
// Swaim Engineering and Surveying — surveying services

const phone = "940-872-5075";
const phoneHref = "tel:+19408725075";
const email = "info@swaimengineering.com";
const emailHref = "mailto:info@swaimengineering.com";
const mapHref = "https://www.google.com/maps/search/?api=1&query=506+N+Mason+St,+Bowie,+TX+76230";
const facebookHref = "https://www.facebook.com/";
const linkedinHref = "https://www.linkedin.com/company/swaim-engineering-&-surveying/";

const services = [
  {
    name: "Land and Boundary Surveys",
    blurb: "Where your property actually ends, established from the deed, the record, and what's on the ground — then monumented and documented so it holds up.",
    when: "Buying or selling, splitting a tract, settling a fence line, or before you build anything near a line.",
  },
  {
    name: "Oil and Gas Surveys",
    blurb: "Well locations, pad sites, pipeline routes, unit boundaries, and lease work for operators across North Texas.",
    when: "Permitting a well, laying pipe, or proving up a unit.",
  },
  {
    name: "Platting",
    blurb: "Subdivision plats prepared to the standards of the city or county reviewing them, with the engineering behind them done in the same office.",
    when: "Dividing land into lots, or any time a municipality requires a recorded plat.",
  },
  {
    name: "Right-of-Way Determination",
    blurb: "Easement and ROW research for roads, utilities, and pipelines — including the deed and record work behind it.",
    when: "Acquiring an easement, or figuring out what one you inherited actually covers.",
  },
  {
    name: "Construction Staking",
    blurb: "Grade, offset, and layout staking so the crew builds what the plan says.",
    when: "Once the design is approved and the dirt work starts.",
  },
  {
    name: "Mapping",
    blurb: "Topographic and planimetric mapping produced for the design work that follows, not as a standalone deliverable nobody uses.",
    when: "Before site design, drainage studies, or roadway layout.",
  },
  {
    name: "GPS Surveying",
    blurb: "RTK and static GPS control for large tracts, remote sites, and anywhere running a traverse would take a week.",
    when: "Big acreage, rough country, or work that needs to tie to a known coordinate system.",
  },
];

const oilGasWork = [
  "Mineral tract surveys",
  "Unit plats",
  "Permit plats",
  "As-drilled plats",
  "P-12 plats",
  "Pipeline plats",
  "Pad site plans",
  "Floodplain exhibits",
];

const counties = [
  "Montague", "Wise", "Parker", "Jack", "Denton",
  "Tarrant", "Cooke", "Dallas", "Young", "Wichita", "Clay",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Surveying — Swaim Engineering and Surveying</title>
    <meta
      name="description"
      content="Boundary surveys, platting, construction staking, and oil and gas surveying in Bowie and North Texas. Registered Professional Land Surveyor on staff since 2003."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Archivo+Narrow:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="svc-page">
    <header class="svc-header">
      <a class="brand" href="/">
        <img src="/assets/swaim-logo-inverted.webp" alt="Swaim Engineering and Surveying" />
      </a>
      <nav class="nav">
        <a href="/about">Company</a>
        <a href="/surveying">Surveying</a>
        <a href="/engineering">Engineering</a>
        <a class="nav-phone" href={phoneHref}>{phone}</a>
        <a class="nav-social" href={facebookHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H16.7V4.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.03 1.46-4.03 4.15v2.32H7.5V14h2.75v8z"/></svg>
        </a>
      </nav>
    </header>

    <!-- ============ INTRO ============ -->
    <section class="svc-intro">
      <div class="svc-intro-copy">
        <p class="label">Surveying &nbsp;·&nbsp; R.P.L.S. 5550</p>
        <h1>Finding the line, and proving it</h1>
        <p class="svc-lede">
          A survey is only worth what it can withstand. Ours are built from the deed, the county
          record, the previous surveyor's notes, and what's actually standing in the pasture
          &mdash; then sealed by a Registered Professional Land Surveyor who has to answer for it.
        </p>
        <div class="svc-actions">
          <a class="btn-primary" href="/start">Start a project</a>
          <a class="btn-ghost-dark" href={phoneHref}>Call {phone}</a>
        </div>
      </div>
      <figure class="svc-intro-figure">
        <button class="seal-btn" type="button"
          data-seal="/assets/swaim-texas-land-surveyor-seal.webp"
          data-caption="Texas Registered Professional Land Surveyor">
          <img src="/assets/swaim-texas-land-surveyor-seal.webp" alt="Texas RPLS seal — click to enlarge" />
        </button>
      </figure>
    </section>

    <!-- ============ SERVICES ============ -->
    <section class="svc-list-wrap">
      <div class="svc-list-head">
        <p class="label">What we do</p>
        <h2>Seven kinds of survey work</h2>
      </div>

      <div class="svc-list">
        {services.map((s) => (
          <article class="svc-item">
            <h3>{s.name}</h3>
            <p class="svc-blurb">{s.blurb}</p>
            <p class="svc-when"><span class="mono">When you need it</span>{s.when}</p>
          </article>
        ))}
        <div class="svc-item svc-blank" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ============ OIL AND GAS ============ -->
    <section class="svc-og">
      <div class="svc-og-head">
        <p class="label light">Oil and gas</p>
        <h2>Twenty-plus years of operator work</h2>
        <p>
          A good share of what leaves this office goes to oil and gas operators working the Barnett
          and the surrounding plays. It's deadline work, and the paperwork has to be right the
          first time or the permit sits.
        </p>
      </div>

      <ul class="og-grid">
        {oilGasWork.map((w) => <li>{w}</li>)}
      </ul>
    </section>

    <!-- ============ RECORDS TIE-IN ============ -->
    <section class="svc-records">
      <div class="svc-records-copy">
        <p class="label">The advantage</p>
        <h2>We may already have your tract on file</h2>
        <p>
          Four generations of Montague County surveyors have handed their records to this office
          &mdash; back through Hardy Seay, B. W. Karsteters, and M. F. Leonard into the 1930s. On a
          boundary question, starting from a predecessor's field notes beats starting from scratch
          every time.
        </p>
        <a class="text-link" href="/about">More about the records &rarr;</a>
      </div>
      <figure class="svc-records-figure">
        <img src="/assets/pic-of-old-mountague-county-soil-survey-on-desk.webp" alt="An old Montague County soil survey open on a desk" />
      </figure>
    </section>

    <!-- ============ WHERE ============ -->
    <section class="svc-where">
      <p class="label">Where we work</p>
      <ul class="county-list">
        {counties.map((c) => <li class="mono">{c}</li>)}
      </ul>
      <p class="svc-where-note">
        Plus surrounding counties. Not sure if you're in range? Call and ask &mdash; the answer is
        usually yes.
      </p>
    </section>

    <!-- ============ CTA ============ -->
    <section class="svc-cta">
      <h2>Need a survey?</h2>
      <p>Give the project a name and we'll pick it up from there. Or just call the office.</p>
      <div class="svc-cta-actions">
        <a class="btn-primary" href="/start">Start a project</a>
        <a class="btn-ghost-light" href={phoneHref}>{phone}</a>
      </div>
    </section>

    <!-- ============ FOOTER AS TITLE BLOCK ============ -->
    <footer class="title-block">
      <div class="tb-cell tb-firm">
        <img src="/assets/swaim-logo-inverted.webp" alt="Swaim Engineering and Surveying" />
        <address class="tb-address">
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            <a href={mapHref} target="_blank" rel="noopener noreferrer">506 North Mason<br />Bowie, TX 76230</a>
          </span>
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5C11.6 19 5 12.4 5 5.1A1.5 1.5 0 0 1 6.5 3.5z"/></svg>
            <a href={phoneHref}>{phone}</a>
          </span>
          <span class="tb-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
            <a href={emailHref}>{email}</a>
          </span>
          <span class="tb-social">
            <a href={facebookHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H16.7V4.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.03 1.46-4.03 4.15v2.32H7.5V14h2.75v8z"/></svg>
            </a>
            <a href={linkedinHref} target="_blank" rel="noopener noreferrer" aria-label="Swaim Engineering on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0zM3.3 8.4h3.4V20H3.3zM9.5 8.4h3.25v1.6h.05c.45-.85 1.56-1.75 3.2-1.75 3.42 0 4.05 2.25 4.05 5.18V20h-3.4v-5.9c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.53-2.25 3.1V20H9.5z"/></svg>
            </a>
          </span>
        </address>
      </div>
      <div class="tb-cell">
        <p class="tb-label">Surveying</p>
        <a href="/surveying">Boundary</a>
        <a href="/surveying">Platting</a>
        <a href="/surveying">Staking</a>
        <a href="/surveying">Oil &amp; gas</a>
      </div>
      <div class="tb-cell">
        <p class="tb-label">Engineering</p>
        <a href="/engineering">Site development</a>
        <a href="/engineering">Roadway</a>
        <a href="/engineering">Drainage</a>
        <a href="/engineering">Water &amp; sewer</a>
      </div>
      <div class="tb-cell tb-stamp">
        <p class="tb-label">Licensed</p>
        <div class="tb-seals">
          <button class="seal-btn" type="button"
            data-seal="/assets/swaim-texas-professional-engineer-seal.webp"
            data-caption="Texas Professional Engineer">
            <img src="/assets/swaim-texas-professional-engineer-seal.webp" alt="Texas P.E. seal" />
          </button>
          <button class="seal-btn" type="button"
            data-seal="/assets/swaim-texas-land-surveyor-seal.webp"
            data-caption="Texas Registered Professional Land Surveyor">
            <img src="/assets/swaim-texas-land-surveyor-seal.webp" alt="Texas RPLS seal" />
          </button>
        </div>
      </div>
      <div class="tb-bar mono">
        <span>&copy; {new Date().getFullYear()} Swaim Engineering and Surveying</span>
      </div>
    </footer>

    <!-- ============ LIGHTBOX ============ -->
    <div class="lightbox" id="lightbox" hidden>
      <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
      <figure>
        <img id="lightbox-img" src="" alt="" />
        <figcaption id="lightbox-cap" class="mono"></figcaption>
      </figure>
    </div>

    <style is:global>
      /* ---------- tokens ---------- */
      :root {
        --ink: #0e1f2a;
        --ink-2: #16303f;
        --buff: #e7dfd0;
        --buff-2: #f3eee4;
        --blue: #4a8ba8;
        --flag: #e2571e;
        --hair: rgba(231, 223, 208, 0.22);

        --display: "Archivo Narrow", "Archivo", system-ui, sans-serif;
        --body: "Archivo", system-ui, -apple-system, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, monospace;
        --serif: "Source Serif 4", Georgia, serif;

        --pad: clamp(1.25rem, 9vw, 10rem);
      }

      * { box-sizing: border-box; }

      body.svc-page {
        margin: 0;
        background: var(--buff-2);
        color: var(--ink);
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 {
        font-family: var(--display);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        margin: 0;
      }

      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--flag); outline-offset: 3px; }

      .mono {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .label {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--blue);
        margin: 0 0 1.25rem;
      }
      .label::before {
        content: "";
        width: 42px;
        height: 2px;
        background: currentColor;
        flex: none;
      }
      .label.light { color: var(--buff); opacity: 0.8; }

      /* ---------- header ---------- */
      .svc-header {
        background: var(--ink);
        color: var(--buff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.25rem var(--pad);
      }
      .brand img { height: 55px; width: auto; display: block; }
      .nav {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        font-family: var(--mono);
        font-size: 0.84rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .nav a { text-decoration: none; opacity: 0.8; transition: opacity 0.2s; }
      .nav a:hover { opacity: 1; }
      .nav-phone { border: 1px solid var(--hair); padding: 0.5rem 0.9rem; opacity: 1 !important; }
      .nav-phone:hover { border-color: var(--flag); color: var(--flag); }
      .nav-social {
        display: inline-flex;
        align-items: center;
        opacity: 0.8;
        transition: opacity 0.2s, color 0.2s;
      }
      .nav-social svg { width: 20px; height: 20px; fill: currentColor; }
      .nav-social:hover { opacity: 1; color: var(--flag); }
      @media (max-width: 860px) { .nav a:not(.nav-phone):not(.nav-social) { display: none; } }

      /* ---------- intro ---------- */
      .svc-intro {
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: clamp(2rem, 6vw, 5rem);
        align-items: center;
        padding: clamp(3.5rem, 9vw, 6.5rem) var(--pad);
      }
      .svc-intro h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
      .svc-lede { margin: 1.5rem 0 0; opacity: 0.8; max-width: 36rem; }
      .svc-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2.25rem; }
      .svc-intro-figure {
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      @media (max-width: 860px) {
        .svc-intro { grid-template-columns: 1fr; }
        .svc-intro-figure { justify-content: flex-start; }
      }

      /* ---------- services ---------- */
      .svc-list-wrap {
        background: #fff;
        padding: clamp(4rem, 10vw, 7rem) var(--pad);
      }
      .svc-list-head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
      .svc-list-head h2 { font-size: clamp(1.8rem, 3.8vw, 2.6rem); }

      .svc-list {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: rgba(14, 31, 42, 0.14);
        border: 1px solid rgba(14, 31, 42, 0.14);
      }
      .svc-item {
        background: #fff;
        padding: 2rem 1.85rem;
        display: grid;
        align-content: start;
        gap: 0.9rem;
      }
      .svc-item h3 { font-size: 1.2rem; }
      .svc-blurb { margin: 0; font-size: 0.97rem; opacity: 0.78; }
      .svc-when {
        margin: 0;
        font-size: 0.9rem;
        opacity: 0.6;
        border-top: 1px solid rgba(14, 31, 42, 0.12);
        padding-top: 0.9rem;
      }
      .svc-when .mono {
        display: block;
        color: var(--blue);
        opacity: 0.9;
        margin-bottom: 0.35rem;
      }
      .svc-item { transition: background 0.2s; }
      .svc-item:hover { background: var(--buff-2); }

      .svc-blank { background: #fbfaf7; }
      .svc-blank:hover { background: #fbfaf7; }

      @media (max-width: 1100px) { .svc-list { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 620px) { .svc-list { grid-template-columns: 1fr; } }

      /* ---------- oil and gas ---------- */
      .svc-og {
        background: var(--ink);
        color: var(--buff);
        padding: clamp(4rem, 10vw, 7rem) var(--pad);
      }
      .svc-og-head { max-width: 42rem; margin-bottom: clamp(2.25rem, 5vw, 3.25rem); }
      .svc-og-head h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
      .svc-og-head p { margin: 1.25rem 0 0; opacity: 0.8; }

      .og-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--hair);
        border: 1px solid var(--hair);
      }
      .og-grid li {
        background: var(--ink);
        padding: 1.4rem 1.35rem;
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.02rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        transition: background 0.2s, color 0.2s;
      }
      .og-grid li:hover {
        background: var(--ink-2);
        color: var(--flag);
      }
      @media (max-width: 900px) { .og-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 520px) { .og-grid { grid-template-columns: 1fr; } }

      /* ---------- records tie-in ---------- */
      .svc-records {
        display: grid;
        grid-template-columns: 1fr 0.85fr;
        gap: clamp(2rem, 6vw, 5rem);
        align-items: center;
        padding: clamp(4rem, 10vw, 7rem) var(--pad);
      }
      .svc-records h2 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); }
      .svc-records-copy p { margin: 1.25rem 0 1.75rem; opacity: 0.78; max-width: 34rem; }
      .text-link {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--flag);
      }
      .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
      .svc-records-figure { margin: 0; }
      .svc-records-figure img {
        width: 100%;
        height: auto;
        display: block;
        border: 1px solid rgba(14, 31, 42, 0.16);
      }
      @media (max-width: 860px) { .svc-records { grid-template-columns: 1fr; } }

      /* ---------- where ---------- */
      .svc-where {
        background: var(--buff);
        padding: clamp(3.5rem, 8vw, 5.5rem) var(--pad);
      }
      .county-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }
      .county-list li {
        border: 1px solid rgba(14, 31, 42, 0.28);
        padding: 0.5rem 0.9rem;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }
      .county-list li:hover {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--buff);
      }
      .svc-where-note { margin: 1.75rem 0 0; opacity: 0.7; max-width: 34rem; }

      /* ---------- cta ---------- */
      .svc-cta {
        background: var(--ink);
        color: var(--buff);
        padding: clamp(4rem, 9vw, 6.5rem) var(--pad);
        text-align: center;
      }
      .svc-cta h2 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); }
      .svc-cta > p { margin: 1.25rem auto 2rem; opacity: 0.78; max-width: 30rem; }
      .svc-cta-actions { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

      .btn-primary,
      .btn-ghost-dark,
      .btn-ghost-light {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 1.05rem 2rem;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }
      .btn-primary { background: var(--flag); color: #fff; border: 0; }
      .btn-primary:hover { background: #c94815; }
      .btn-ghost-dark { border: 1px solid rgba(14, 31, 42, 0.3); }
      .btn-ghost-dark:hover { border-color: var(--flag); color: var(--flag); }
      .btn-ghost-light { border: 1px solid var(--hair); }
      .btn-ghost-light:hover { border-color: var(--flag); color: var(--flag); }

      /* ---------- footer / title block ---------- */
      .title-block {
        background: var(--ink);
        color: var(--buff);
        border-top: 2px solid var(--buff);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 0 calc(var(--pad) - 1.5rem);
      }
      .tb-cell {
        padding: 2rem 1.5rem;
        border-right: 1px solid var(--hair);
        display: grid;
        gap: 0.55rem;
        align-content: start;
      }
      .tb-stamp { border-right: none; }
      .tb-cell a {
        text-decoration: none;
        font-size: 0.92rem;
        opacity: 0.72;
        transition: opacity 0.2s, color 0.2s;
      }
      .tb-cell a:hover { opacity: 1; color: var(--flag); }
      .tb-label {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--blue);
        margin: 0 0 0.4rem;
      }
      .tb-firm img { height: 40px; width: auto; }
      .tb-address {
        font-style: normal;
        font-size: 0.92rem;
        line-height: 1.4;
        opacity: 0.72;
        margin: 0;
        display: grid;
        gap: 0.7rem;
      }
      .tb-address a { opacity: 1; }
      .tb-line {
        display: grid;
        grid-template-columns: 16px 1fr;
        gap: 0.65rem;
        align-items: start;
      }
      .tb-line a:hover { color: var(--flag); }
      .tb-line svg {
        width: 16px;
        height: 16px;
        margin-top: 0.22em;
        fill: none;
        stroke: var(--blue);
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .tb-social { display: flex; gap: 0.85rem; padding-left: calc(16px + 0.65rem); }
      .tb-social a { display: inline-flex; opacity: 0.72; transition: opacity 0.2s, color 0.2s; }
      .tb-social svg { width: 20px; height: 20px; fill: currentColor; }
      .tb-social a:hover { opacity: 1; color: var(--flag); }
      .tb-seals { display: flex; flex-direction: row-reverse; gap: 0.6rem; }
      .tb-seals .seal-btn img { width: 104px; height: auto; }
      .tb-bar {
        grid-column: 1 / -1;
        border-top: 1px solid var(--hair);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        opacity: 0.55;
      }
      @media (max-width: 980px) {
        .title-block { grid-template-columns: 1fr 1fr; }
        .tb-cell { border-bottom: 1px solid var(--hair); }
      }
      @media (max-width: 560px) {
        .title-block { grid-template-columns: 1fr; }
        .tb-cell { border-right: none; }
      }

      /* ---------- lightbox ---------- */
      .seal-btn {
        background: none;
        border: 0;
        padding: 0;
        cursor: zoom-in;
        display: block;
        transition: transform 0.2s;
      }
      .seal-btn:hover { transform: scale(1.05); }
      .seal-btn img {
        width: clamp(150px, 18vw, 220px);
        height: auto;
        display: block;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(14, 31, 42, 0.94);
        display: grid;
        place-items: center;
        padding: var(--pad);
      }
      .lightbox[hidden] { display: none; }
      .lightbox figure { margin: 0; text-align: center; }
      .lightbox img {
        max-width: min(560px, 88vw);
        max-height: 76vh;
        width: auto;
        height: auto;
      }
      .lightbox figcaption { margin-top: 1.25rem; color: var(--buff); opacity: 0.7; }
      .lightbox-close {
        position: absolute;
        top: 1.5rem;
        right: var(--pad);
        background: none;
        border: 1px solid var(--hair);
        color: var(--buff);
        font-size: 1.75rem;
        line-height: 1;
        width: 3rem;
        height: 3rem;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s;
      }
      .lightbox-close:hover { border-color: var(--flag); color: var(--flag); }
    </style>

    <script>
      const box = document.getElementById("lightbox");
      const boxImg = document.getElementById("lightbox-img");
      const boxCap = document.getElementById("lightbox-cap");
      let lastFocus = null;

      function openBox(src, caption, trigger) {
        lastFocus = trigger;
        boxImg.src = src;
        boxImg.alt = caption;
        boxCap.textContent = caption;
        box.hidden = false;
        document.body.style.overflow = "hidden";
        box.querySelector(".lightbox-close").focus();
      }

      function closeBox() {
        box.hidden = true;
        boxImg.src = "";
        document.body.style.overflow = "";
        if (lastFocus) lastFocus.focus();
      }

      document.querySelectorAll(".seal-btn").forEach((btn) => {
        btn.addEventListener("click", () =>
          openBox(btn.dataset.seal, btn.dataset.caption, btn)
        );
      });

      box.querySelector(".lightbox-close").addEventListener("click", closeBox);
      box.addEventListener("click", (e) => { if (e.target === box) closeBox(); });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !box.hidden) closeBox();
      });
    </script>
  </body>
</html>
