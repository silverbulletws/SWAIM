---
// src/pages/engineering.astro
import Base from "../layouts/Base.astro";
import Seal from "../components/Seal.astro";
import { site, counties } from "../data/site.js";
import { engineeringServices as services } from "../data/services.js";
import "../styles/service-page.css";


const plans = [
  { name: "Kingdom Ridge", kind: "Site plan", file: "/assets/site-plan-kingdom-ridge.pdf" },
  { name: "Crown Point", kind: "Site plan", file: "/assets/site-plan-crown-point.pdf" },
  { name: "United Storage", kind: "Site plan", file: "/assets/site-plan-united-storage.pdf" },
  { name: "Access Road", kind: "Sketch", file: "/assets/access-road-sketch.pdf" },
];
---

<Base
  title="Engineering — Swaim Engineering and Surveying"
  description="Civil engineering in Bowie and North Texas: site development, drainage, roadway, water and sewer design. Licensed Professional Engineer, working off our own survey data."
>
  <!-- ============ INTRO ============ -->
  <section class="svc-intro">
    <div class="svc-intro-copy">
      <p class="label">Engineering &nbsp;·&nbsp; P.E. 84832</p>
      <h1>Designed in-house using our topo survey</h1>
      <p class="svc-lede">
        Most civil engineering starts with somebody else's boundary work and a hope that it's
        right. Ours starts with field data collected by us, which means the survey and the plans
        agree with each other before either one leaves the building.
      </p>
      <div class="svc-actions">
        <a class="btn-primary" href="/start">Start a project</a>
        <a class="btn-ghost-dark" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </div>
    <figure class="svc-intro-figure">
      <Seal which="pe" />
    </figure>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="svc-list-wrap">
    <div class="svc-list-head">
      <p class="label">What we do</p>
      <h2>Some of our services</h2>
      <p>If you don't see it here, ask. We have partners for most everything you will need.</p>
    </div>

    <div class="svc-list">
      {services.map((s) => (
        <article class="svc-item">
          <h3>{s.name}</h3>
          <p class="svc-blurb">{s.long}</p>
          <p class="svc-when"><span class="mono">When you need it</span>{s.when}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ PLAN SETS ============ -->
  <section class="svc-og">
    <div class="svc-og-head">
      <p class="label light">Recent sets</p>
      <h2>Plans that got built</h2>
      <p>
        Four sets straight out of the office. Open them and see how a Swaim drawing reads before
        you hire anybody.
      </p>
    </div>

    <div class="plan-grid">
      {plans.map((p) => (
        <a class="plan-card" href={p.file} target="_blank" rel="noopener">
          <span class="plan-kind mono">{p.kind}</span>
          <span class="plan-name">{p.name}</span>
          <span class="plan-open mono">Open PDF &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ ONE OFFICE TIE-IN ============ -->
  <section class="svc-records">
    <div class="svc-records-copy">
      <p class="label">The advantage</p>
      <h2>No handoff between firms</h2>
      <p>
        When the surveyor and the engineer are two different companies, you carry the drawings
        between them — and you eat the change order when the grading plan gets drawn off the
        wrong line. Here the boundary work and the design work happen in the same building, off
        the same field data, checked by people who talk before there's a problem.
      </p>
      <a class="text-link" href="/surveying">See the surveying side &rarr;</a>
    </div>
    <figure class="svc-records-figure">
      <img src="/assets/jason-reviewing-design-diagrams.webp" alt="Reviewing design diagrams in the Bowie office" />
    </figure>
  </section>

  <!-- ============ WHERE ============ -->
  <section class="svc-where">
    <p class="label">Where we work</p>
    <ul class="county-list">
      {counties.map((c) => <li class="mono">{c}</li>)}
    </ul>
    <p class="svc-where-note">
      Plus surrounding counties. Not sure if you're in range? Call and ask — the answer is
      usually yes.
    </p>
  </section>

  <!-- ============ CTA ============ -->
  <section class="svc-cta">
    <h2>Got a site to develop?</h2>
    <p>Give the project a name and we'll pick it up from there. Or just call the office.</p>
    <div class="svc-cta-actions">
      <a class="btn-primary" href="/start">Start a project</a>
      <a class="btn-ghost-light" href={site.phoneHref}>{site.phone}</a>
    </div>
  </section>
</Base>